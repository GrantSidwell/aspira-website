---
const links = [
  { href: '/', label: 'Home' },
  { href: '/project', label: 'Project' },
  { href: '/model', label: '3D model' },
  { href: '/team', label: 'Team' },
];
const path = Astro.url.pathname;
---
<header>
  <div class="wrap bar">
    <a class="logo" href="/" aria-label="Aspira home"><span class="mark">A</span> Aspira</a>
    <nav>
      {links.map((l) => (
        <a href={l.href} aria-current={(l.href === '/' ? path === '/' : path.startsWith(l.href)) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
<style>
  header { position: sticky; top: 0; z-index: 10; background: rgba(245,242,236,.88); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 68px; gap: 16px; }
  .logo { font-family: var(--serif); font-size: 1.45rem; color: var(--ink); text-decoration: none; display: flex; align-items: center; gap: 10px; }
  .mark { width: 34px; height: 34px; border-radius: 50% 50% 4px 4px; background: var(--green); color: #fff; display: grid; place-items: center; font-size: 1.05rem; }
  nav { display: flex; gap: 22px; }
  nav a { color: var(--ink-soft); text-decoration: none; font-size: .95rem; }
  nav a[aria-current='page'], nav a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 6px; text-decoration-color: var(--brick); }
  @media (max-width: 560px) { nav { gap: 14px; } nav a { font-size: .85rem; } .logo { font-size: 1.2rem; } }
</style>
